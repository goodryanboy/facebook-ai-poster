# Copy this file to .env for local testing only.
# In GitHub Actions, these are set as repo Secrets/Variables instead (see README).

# --- Image provider (set at least one) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Optional: force provider for a run ("gemini" | "openai") — overrides page config
IMAGE_PROVIDER=

# Prefer per-page settings in prompts.json → pages.<key>.config:
#   postType, imageProvider, imageModel, imageSize, published, link, slots, ...

# Optional: overrides prompts.json rotation with a fixed prompt (all pages)
IMAGE_PROMPT=

# Optional: only run a subset of pages, e.g. main,other
PAGES=

# --- Multi-page credentials (recommended; keep out of git) ---
# Keys MUST match prompts.json → pages. Do NOT put pageId in prompts.json.
# Example:
# FB_PAGE_IDS={"main":"123456789012345","second-page":"987654321098765"}
# FB_PAGE_TOKENS={"main":"EAAxxxx","second-page":"EAAyyyy"}
FB_PAGE_IDS=
FB_PAGE_TOKENS=

# --- Legacy single-page fallback (optional if FB_PAGE_IDS / FB_PAGE_TOKENS are set) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

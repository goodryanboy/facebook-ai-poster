# Copy this file to .env for local testing only.
# In GitHub Actions, these are set as repo Secrets/Variables instead (see README).

OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Optional: overrides prompts.json rotation with a fixed prompt
IMAGE_PROMPT=

FB_PAGE_ID=your_page_id
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# Optional: overrides the auto-caption (defaults to the image prompt text)
FB_CAPTION=
